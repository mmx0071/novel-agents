# 复制为 .env 并填入真实 Key（.env 已被 gitignore，不会提交）
#
#   cp .env.example .env
#
# DeepSeek Plan：在 https://platform.deepseek.com 获取 API Key

# DeepSeek（当前默认 Provider，所有任务共用此 Key）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# LLM 档位：dev=全部用 deepseek-v4-flash（快/便宜）；prod=按 config/llm.yaml 分模型
# 不设则跟随 config/llm.yaml 的 profile（当前默认 dev）
# NOVELX_LLM_PROFILE=dev

# 备用 Provider（仅当 config/llm.yaml 改回 openai/anthropic 时需要）
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
